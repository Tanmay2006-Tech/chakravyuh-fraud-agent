# Chakravyuh fraud graph schema (TigerGraph 4.2+)
CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING, network STRING, card_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Fingerprint (PRIMARY_ID id STRING, wcc_id INT DEFAULT -1) WITH primary_id_as_attribute="true"
CREATE VERTEX Txn (PRIMARY_ID id STRING, ts DATETIME, amount DOUBLE, product STRING, channel STRING, risk_score DOUBLE, region STRING, country STRING, dist1 DOUBLE, p_email STRING, r_email STRING, c1 DOUBLE, c13 DOUBLE, d1 DOUBLE, m4 STRING, device_new_flag STRING, proxy_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING, profile STRING, device_type STRING, wcc_id INT DEFAULT -1) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX FraudPattern (PRIMARY_ID id STRING, description STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME, outcome STRING, pattern STRING, n_txns INT, exposure DOUBLE, actions STRING, report_filed STRING, notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX InvestigationCase (PRIMARY_ID id STRING, hhg_case STRING, opened_at DATETIME, case_status STRING, verdict STRING, pattern STRING, probability DOUBLE, exposure DOUBLE, sar_filed BOOL, summary STRING, final_actions STRING, timeline STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX KnowledgeDoc (PRIMARY_ID id STRING, kind STRING, title STRING, content STRING) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Txn) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE USED_FINGERPRINT (FROM Txn, TO Fingerprint) WITH REVERSE_EDGE="FINGERPRINT_OF"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Txn, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Txn, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_OF"
CREATE DIRECTED EDGE BILLED_IN (FROM Txn, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Txn | FROM InvestigationCase, TO Txn) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card | FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="HAS_CASE"
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card | FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CASE"
CREATE DIRECTED EDGE CASE_DEVICE (FROM InvestigationCase, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_CASE"
CREATE DIRECTED EDGE HAS_PATTERN (FROM ClosedCase, TO FraudPattern | FROM InvestigationCase, TO FraudPattern) WITH REVERSE_EDGE="PATTERN_OF"
CREATE DIRECTED EDGE SIMILAR_TO (FROM InvestigationCase, TO ClosedCase | FROM InvestigationCase, TO InvestigationCase) WITH REVERSE_EDGE="SIMILAR_FROM"
# graph-algorithm projection: card-in-use x rare device profile, built by tigergraph/algorithms/build_uses_device.gsql; GDS tg_wcc writes wcc_id
CREATE UNDIRECTED EDGE USES_DEVICE (FROM Fingerprint, TO DeviceProfile)

CREATE GRAPH FraudGraph (*)
