# ---- TigerGraph (Savanna) — read by tigergraph-mcp ----
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_USERNAME=<database user>
TG_PASSWORD=<database password>
# or instead of username/password (Savanna: Access Management → secrets):
# TG_SECRET=<gsql secret>
# TG_API_TOKEN=<token>
TG_TGCLOUD=true
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_SSL_PORT=443

# ---- LLM (primary + automatic failover to the other if its key is set) ----
LLM_PROVIDER=groq
GROQ_API_KEY=<groq api key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BACKUP_MODEL=openai/gpt-oss-20b   # optional: Groq rate limits are per model, so a 429 can fail over here
GEMINI_API_KEY=<gemini api key from aistudio.google.com/apikey>
GEMINI_MODEL=gemini-3.6-flash
# LLM_MODEL=<optional legacy override for the primary provider's model>
